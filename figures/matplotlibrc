# Shared figure style: vector output, embedded fonts, Okabe-Ito palette.
figure.figsize : 6.5, 4.0
figure.dpi : 100
savefig.format : pdf
savefig.bbox : tight
pdf.fonttype : 42
ps.fonttype : 42
font.family : sans-serif
font.sans-serif : DejaVu Sans, Helvetica, Arial
font.size : 9
axes.titlesize : 10
axes.labelsize : 9
legend.fontsize : 8
xtick.labelsize : 8
ytick.labelsize : 8
axes.spines.top : False
axes.spines.right : False
axes.grid : True
grid.alpha : 0.3
grid.linewidth : 0.5
lines.linewidth : 1.4
axes.prop_cycle : cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000'])
